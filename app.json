{
  "expo": {
    "name": "oryn",
    "slug": "oryn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oryn",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.mao1729.oryn",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification",
          "processing",
          "fetch",
          "remote-notification",
          "processing"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "com.expo.modules.backgroundtask.processing",
          "ORYN_BACKGROUND_SYNC_TASK",
          "com.expo.modules.backgroundtask.processing",
          "ORYN_BACKGROUND_SYNC_TASK"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mao1729.oryn",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1A1A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "googleServicesFile": "./google-services.json",
          "iosUrlScheme": "com.googleusercontent.apps.751305008800-4e18gl7i6jgghfs1t6ukviuo7h4qe33p"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFFFFF",
          "defaultChannel": "oryn"
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-image",
      "./plugins/withWidgets.js",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "srcDir": "src"
    },
    "extra": {
      "projectId": "bde0d9cf7958c80bd96ca4d8826ccce0",
      "projectIdentityNumber": 7401,
      "projectIdentityTag": "#ORYN-7401",
      "devFingerprint": "dev_210ee3f0cd58",
      "prodFingerprint": "prod_5fee03d910b5",
      "router": {},
      "eas": {
        "projectId": "dce4319a-073e-4ab1-90fd-e864d062a91e"
      }
    },
    "owner": "mao1729"
  }
}
